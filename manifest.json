{
  "manifest_version": 3,
  "name": "TL Çevirici",
  "version": "1.1.0",
  "description": "Sayfada seçtiğin, çift tıkladığın veya kopyaladığın döviz tutarını TCMB kuruyla TL'ye çevirir.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.tcmb.gov.tr/*"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TL Çevirici",
    "default_icon": { "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["parser.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": { "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "browser_specific_settings": {
    "gecko": {
      "id": "tl-cevirici@huseyinacikgoz",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
